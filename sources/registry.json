{
  "title": "UOGW Source Registry",
  "version": "1.1",
  "updated": "2026-08-04",
  "policy": {
    "include": "Public domain, open government, research open data, and explicitly redistributable citizen science",
    "exclude": "Proprietary commercial PWS bulk dumps without redistribution rights",
    "mirror_policy": "Prefer indexes and selective extracts; full bulk remains at authoritative hosts",
    "attribution": "Required for every use — curator + original provider"
  },
  "sources": [
